TRADING_MODE=paper
SYMBOLS=BTCUSDT,ETHUSDT
PAPER_START_BALANCE=10000
RISK_PER_TRADE_PCT=0.25
MAX_DAILY_LOSS_PCT=2
MAX_DRAWDOWN_PCT=10
MAX_OPEN_POSITIONS=3
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=1.5
ATR_TAKE_MULTIPLIER=3
# Only for testnet/live; never commit real values
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Required only to unlock live mode, which remains disabled by default
LIVE_TRADING_CONFIRM=
# Where the `live` loop persists RiskGate state across restarts
RISK_STATE_PATH=data/risk_state.json
# How often (seconds) the `live` loop re-evaluates each symbol
LIVE_POLL_SECONDS=60

# --- Safety limits (live mode only; defaults shown) ---
# Caps one order's notional as a share of the account balance.
MAX_NOTIONAL_PCT=20
# How far the OCO stop-limit leg sits below its trigger, so a fast move still fills it.
STOP_LIMIT_BUFFER_PCT=0.2
# Where open positions are recorded, so a restart does not lose track of a trade
POSITIONS_PATH=data/positions.json
# Refuse to trade with an API key that has no IP allowlist. Set to 0 only knowingly.
REQUIRE_KEY_IP_RESTRICTION=1
# Stop the live loop after this many failed cycles in a row.
MAX_CONSECUTIVE_FAILURES=5
# Binance recvWindow for signed requests, in milliseconds.
RECV_WINDOW_MS=5000
# How long a symbol's exchange filters are cached instead of re-fetching exchangeInfo.
FILTERS_CACHE_SECONDS=3600
# Request-weight budget per minute; new entries pause at 80% of it.
MAX_WEIGHT_PER_MINUTE=1200
# Candle interval the strategy decides on.
KLINE_INTERVAL=1h
# Trades are limited per hour; the limit counts entries.
MAX_TRADES_PER_HOUR=6
